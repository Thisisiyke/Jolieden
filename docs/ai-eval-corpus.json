{
  "$schema": "./ai-eval-corpus.schema.json",
  "version": "0.1",
  "description": "AI Concierge regression corpus. Each case lists an inbound client SMS, the expected tool calls, traits the response must exhibit, and whether escalation should fire. Run before every prompt or knowledge-base change. Starter set of 32 cases; grow to 200+ in Phase 2 with real-traffic samples.",
  "categories": {
    "booking": "Client wants to book a service",
    "rebook": "Returning client wants their usual",
    "faq_policy": "Policy/hours/pricing question",
    "faq_prep": "Prep instruction question",
    "complaint": "Negative sentiment, service issue, refund ask",
    "escalation_required": "Out of catalog, unknown, requires human",
    "scheduling_change": "Reschedule/cancel/late",
    "multi_lang": "Non-English inbound",
    "edge": "Ambiguous, low-info, or potentially adversarial"
  },
